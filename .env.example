# Скопируй этот файл в .env и вставь свои ключи после знака =.
# .env в git не попадает (см. .gitignore). Ключи никому не пересылать.

# Стоки для вставок (stock.py). Бесплатные ключи:
#   Pexels  — https://www.pexels.com/api/
#   Pixabay — https://pixabay.com/api/docs/
PEXELS_API_KEY=
PIXABAY_API_KEY=

# Облачное распознавание речи ElevenLabs Scribe (transcribe.py --engine eleven).
# Не обязателен: по умолчанию распознавание локальное (faster-whisper).
ELEVENLABS_API_KEY=
